PORTKEY_CLIENT_AUTH="client-auth-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ORGANISATIONS_TO_SYNC="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
SERVICE_NAME=portkey-gateway
PORTKEY_REGISTRY_USERNAME="your-registry-username"
PORTKEY_REGISTRY_PASSWORD="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Optional — file-to-text-webhook: which decoder to try first for an
# attachment. "markitdown" (default) is cheap/local and tried first; "model"
# asks the request's own target model to transcribe it instead (costs a
# second LLM call) -- only used as a fallback when markitdown's output looks
# garbled, unless you set DECODE_BACKEND=model to flip the default.
DECODE_BACKEND="markitdown"

# Required for the markitdown→model fallback to ever fire (and whenever
# DECODE_BACKEND=model) — a gateway API key this webhook uses for its own
# callback to transcribe attachments. Must be a dedicated service credential:
# the gateway refuses to forward the caller's own Authorization header to
# webhook guardrails, so this can't just reuse the end user's token.
INTERNAL_GATEWAY_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional — file-to-text-webhook: Azure AI Document Intelligence backend for
# MarkItDown. Leave both unset to keep the default pdfminer backend.
DOCINTEL_ENDPOINT="https://<resource-name>.cognitiveservices.azure.com/"
AZURE_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"